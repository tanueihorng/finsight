{
  "name": "finsight",
  "version": "1.0.0",
  "description": "A personal Bloomberg-style terminal for tracking your portfolio with free, no-API-key market data (Yahoo Finance, World Bank, FRED, FX-risk + economic calendar).",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "node server.ts",
    "test": "node --test \"test/*.test.ts\" \"web/src/**/*.test.ts\"",
    "demo": "node scripts/demo.ts",
    "demo:reset": "node scripts/demo.ts --reset",
    "agent:install": "npm --prefix agent ci --no-audit --no-fund",
    "agent:test": "npm --prefix agent run check",
    "e2e": "playwright test",
    "build": "node scripts/build-web.mjs",
    "dev": "node scripts/build-web.mjs --watch",
    "typecheck": "tsc -p web && tsc -p web/tsconfig.test.json && tsc -p .",
    "check:web": "node scripts/build-web.mjs --check",
    "verify": "npm run typecheck && npm test && npm run check:web && npm run e2e"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "tanueihorng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanueihorng/finsight.git"
  },
  "keywords": [
    "portfolio",
    "stocks",
    "terminal",
    "finance",
    "fx-risk",
    "yahoo-finance",
    "fred",
    "no-dependencies"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  }
}
